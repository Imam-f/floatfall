{
  "name": "floatfall",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @floatfall/desktop",
    "build": "npm run build -w @floatfall/extension && npm run build -w @floatfall/desktop",
    "build:extension": "npm run build -w @floatfall/extension",
    "build:desktop": "npm run build -w @floatfall/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --experimental-strip-types --test tests/pitch.test.mts tests/microphone.test.mjs tests/worker.test.mjs tests/settings.test.mjs",
    "test:microphone": "npm run build:desktop && node tests/run-electron-test.mjs",
    "test:settings": "npm run build:desktop && node tests/run-electron-test.mjs settings"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
